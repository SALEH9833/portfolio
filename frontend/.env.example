# =============================================================================
# Portfolio — .env.example
# Local : copie ce fichier vers .env.local et remplis les valeurs.
# Vercel : Project → Settings → Environment Variables (mêmes noms).
# =============================================================================

# ---- Base de données PostgreSQL ----
# Vercel : connecte une base Neon (Storage → Neon) → DATABASE_URL est ajouté tout seul.
# Local : postgres://postgres:motdepasse@localhost:5432/portfolio
DATABASE_URL=

# ---- Stockage des images uploadées ----
# Vercel : connecte un Blob Store (Storage → Blob) → BLOB_READ_WRITE_TOKEN ajouté tout seul.
# Local : laisser vide (les fichiers vont dans public/uploads).
BLOB_READ_WRITE_TOKEN=

# ---- Sécurité ----
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-random-96-chars-string
JWT_EXPIRES_IN=7d

# ---- Admin ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Email Gmail (formulaire de contact) ----
# App Password Gmail : https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ton.email@gmail.com
EMAIL_PASS=
EMAIL_TO=ton.email@gmail.com

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
CONTACT_LIMIT_WINDOW_MS=3600000
CONTACT_LIMIT_MAX=5

# ---- Anthropic (chatbot IA) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Site ----
FRONTEND_URL=https://salehmahamatsaleh.com
